      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rabbitmq_queue_consumers) by (queue)",
          "legendFormat": "Queue: {{queue}}",
