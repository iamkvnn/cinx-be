      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "process_cpu_usage{application=\"$application\"} * 100",
          "legendFormat": "Process CPU Usage ({{instance}})",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "system_cpu_usage{application=\"$application\"} * 100",
          "legendFormat": "System CPU Usage ({{instance}})",
          "range": true,
          "refId": "B"
        }
